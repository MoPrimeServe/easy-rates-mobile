{
  "name": "easyrates-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EasyRates backend monorepo — Node.js + Express + TypeScript, Prisma + PostgreSQL, Redis/BullMQ. Built to the sealed system-design canonical contracts (ADR-002 passwordless OTP).",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:generate": "pnpm --filter ./packages/db exec prisma generate",
    "db:migrate": "pnpm --filter ./packages/db exec prisma migrate dev",
    "db:push": "pnpm --filter ./packages/db exec prisma db push",
    "db:seed": "pnpm --filter ./packages/db run seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
