# =============================================================================
# EasyRates backend — local dev environment template
# Copy to `.env` (`cp .env.example .env`) and fill real values. NEVER commit .env.
# Every var is Zod-validated at startup by packages/config (fails fast if missing).
# =============================================================================

# ---- Database (Prisma → PostgreSQL; local stand-in for Azure SQL) -----------
# Local dev uses a real Postgres 16. In containers, host = `postgres` (compose
# service name). Example shows the compose form; the local socket form is:
#   postgresql://USER@localhost/easyrates_dev?host=/var/run/postgresql&schema=public
DATABASE_URL="postgresql://app:CHANGE_ME@postgres:5432/easyrates?schema=public&connection_limit=3"

# ---- Redis (BullMQ broker + OTP TTL / session cache) ------------------------
# Host `redis` = compose service name. db index 0. No password in local dev.
REDIS_URL="redis://redis:6379"

# ---- Runtime config (non-secret) --------------------------------------------
NODE_ENV=development                    # development | test | production
PORT=3000                               # internal port every Node.js service listens on
ALLOWED_ORIGINS=http://localhost:3000   # CORS allow-list; comma-separated

# ---- JWT (auth-service — ADR-001 §D) ----------------------------------------
# Generate secrets with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME                    # signs short-lived access tokens
JWT_REFRESH_SECRET=CHANGE_ME            # signs long-lived refresh tokens (must differ from JWT_SECRET)
JWT_ACCESS_TTL_SECONDS=900              # access token TTL = 15 min (ADR-001 §D)
JWT_REFRESH_TTL_DAYS=30                 # refresh token TTL = 30 days (ADR-001 §D)

# RS256 keypair signs/verifies access tokens (conventions §6). Generate dev keys with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-rs256-private.pem
#   openssl rsa -pubout -in keys/jwt-rs256-private.pem -out keys/jwt-rs256-public.pem
# Supply inline PEM (JWT_PRIVATE_KEY_PEM / JWT_PUBLIC_KEY_PEM) OR a path (below).
JWT_PRIVATE_KEY_PEM_PATH=./keys/jwt-rs256-private.pem   # gitignored in dev
JWT_PUBLIC_KEY_PEM_PATH=./keys/jwt-rs256-public.pem
JWT_ISSUER=easyrates-auth
JWT_AUDIENCE=easyrates-api

# ---- OTP lifecycle (otp-service contract central values) --------------------
OTP_TTL_SECONDS=600                     # code TTL
OTP_RESEND_COOLDOWN_SECONDS=30          # min seconds between resends
OTP_MAX_RESENDS_PER_SESSION=3
OTP_MAX_INVALID_ATTEMPTS=5
REGISTRATION_TOKEN_TTL_SECONDS=600      # single-use registrationToken TTL
OTP_MOCK=true                           # true: generate+log/return code (no Twilio). MUST be false in prod.
INTERNAL_API_SECRET=CHANGE_ME           # server-to-server secret for POST /otp/send [internal]
OTP_SERVICE_URL=http://localhost:3002   # auth → otp base URL

# ---- ID-number HMAC pepper (ADR-003) ----------------------------------------
# Keyed-hash pepper for User.idNumberHash / Property.holderIdNumberHashes.
# Plaintext SA ID numbers are NEVER stored. Generate with: openssl rand -base64 48
ID_NUMBER_HMAC_PEPPER=CHANGE_ME

# ---- Twilio Verify (OTP delivery — ADR-001 §B) ------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Console → Account Info
TWILIO_AUTH_TOKEN=CHANGE_ME                             # Console → Account Info (secret)
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Console → Verify → Services → Service SID

# ---- Municipality webhook (municipality-service — inbound CRM ingestion) -----
# Shared secret sent in the X-Municipal-Webhook-Secret header. Generate with:
# openssl rand -base64 48
MUNICIPAL_WEBHOOK_SECRET=CHANGE_ME
