# =============================================================================
# EasyRates — local dev environment template
# Copy to `.env` (`cp .env.example .env`) and fill real values. NEVER commit .env.
# Referenced by podman-compose.skeleton.yml. Every var the compose file reads
# is documented here.
# =============================================================================

# ---- PostgreSQL (local stand-in for Azure SQL) ------------------------------
# Used by the `postgres` container to initialise the DB, and by pg_isready in
# its healthcheck. Keep in sync with DATABASE_URL below.
POSTGRES_USER=app                       # DB superuser created on first boot
POSTGRES_PASSWORD=CHANGE_ME             # dev-only password; any non-empty value
POSTGRES_DB=easyrates                   # database name created on first boot

# Prisma connection string used by every Node.js service.
# Host `postgres` = the compose service name (container-to-container DNS).
# ⚠️ connection_limit=3 → 9 services × 3 = 27 < Basic 30-worker ceiling.
#    nfr.md still says limit=4 (7-service math). PENDING ratification in plan/05.
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/easyrates?schema=public&connection_limit=3

# Optional host-side port remaps (set if 5432/6379 are already in use locally).
POSTGRES_EXT_PORT=5432                  # host port mapped to postgres:5432
REDIS_EXT_PORT=6379                     # host port mapped to redis:6379

# ---- Redis (BullMQ broker + OTP TTL / session cache) ------------------------
# Host `redis` = compose service name. db index 0. No password in local dev.
REDIS_URL=redis://redis:6379            # BullMQ + cache connection string

# ---- Twilio Verify (OTP delivery — ADR-001 §B) ------------------------------
# Obtain from Twilio Console (console.twilio.com). Use TEST credentials in dev
# to avoid per-verification billing (ADR-001 consequences).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Console → Account Info
TWILIO_AUTH_TOKEN=CHANGE_ME                             # Console → Account Info (secret)
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Console → Verify → Services → Service SID

# ---- Runtime config (non-secret) --------------------------------------------
NODE_ENV=development                    # development | test | production
PORT=3000                              # internal port every Node.js service listens on
ALLOWED_ORIGINS=http://localhost:3000   # CORS allow-list; comma-separated. Flutter dev/web origin

# ---- JWT (auth-service — ADR-001 §D) ----------------------------------------
# Generate secrets with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME                    # signs short-lived access tokens
JWT_REFRESH_SECRET=CHANGE_ME            # signs long-lived refresh tokens (must differ from JWT_SECRET)
JWT_ACCESS_TTL_SECONDS=900              # access token TTL = 15 min (ADR-001 §D)
JWT_REFRESH_TTL_DAYS=30                 # refresh token TTL = 30 days (ADR-001 §D)

# ---- Municipality webhook (municipality-service — inbound CRM ingestion) -----
# Shared secret the municipal back-office / clerk portal sends in the
# `X-Municipal-Webhook-Secret` header on POST /municipality/objections/:ref/response.
# Generate with: openssl rand -base64 48. Not a JWT; rotated out-of-band with the municipality.
MUNICIPAL_WEBHOOK_SECRET=CHANGE_ME

# ---- pgAdmin (dev-only — only used with `--profile dev`) ---------------------
PGADMIN_DEFAULT_EMAIL=dev@easyrates.local   # login email for the pgAdmin UI (http://localhost:5050)
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME          # login password for the pgAdmin UI
